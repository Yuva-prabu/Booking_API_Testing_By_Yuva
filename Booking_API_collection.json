        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsondat = pm.response.json();\r\npm.environment.set(\"b_id\", jsondat.bookingid);\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n\r\npm.test(\"Verifybody matched string\", function () {\r\n    pm.expect(pm.response.text()).to.include(\"Testerss\");\r\n});\r\n\r\npm.test(\"Verify content type header\", function () {\r\n    pm.response.to.have.header('Content-Type', 'application/json; charset=utf-8');\r\n});\r\n\r\npm.test(\"Verify response time is less than 1000 ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(1000);\r\n});\r\n"
                ]
              }
            }
          ],
